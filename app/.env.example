# 复制本文件为 .env 并填入你的 key（.env 已被 .gitignore 忽略，不会提交/外泄）。
# 优先级：系统环境变量 > .env。至少二选一。

# 研究要发远端 LLM 时（默认 local_strict 不出机）：
DEEPSEEK_API_KEY=sk-_______________________
# 或阿里云通义兜底：
# DASHSCOPE_API_KEY=

# 隐私：local_strict=内容不出机（默认，禁用远端）；approved_remote=授权发远端；
#       mixed_sanitized=原始留本地、只发脱敏
STATA_AGENT_PRIVACY=approved_remote

# 可选：
STATA_AGENT_UI_PORT=8001
STATA_AGENT_DB=samples/ideas/main/ledger.sqlite3
# STATA_AGENT_EXECUTOR=stata        # 真 Stata（本机已装时开启；否则用演示/Fake）
# STATA_AGENT_DEMO=1                # 离线演示（无 key 也走通，默认关）
