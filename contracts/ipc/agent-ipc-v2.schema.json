    "discriminator": {
      "mapping": {
        "worker_advance": "#/$defs/WorkerAdvance",
        "worker_bootstrap": "#/$defs/WorkerBootstrap",
        "worker_model_output": "#/$defs/WorkerModelOutput",
        "worker_shutdown": "#/$defs/WorkerShutdown"
