{
  "main_to_worker": {
    "$defs": {
      "WorkerAdvance": {
        "additionalProperties": false,
        "description": "Authorize the disposable Worker to request one logical model invocation.",
        "properties": {
          "context_revision": {
            "minimum": 1,
            "title": "Context Revision",
            "type": "integer"
          },
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "message_type": {
            "const": "worker_advance",
            "title": "Message Type",
            "type": "string"
          },
          "protocol_version": {
            "const": "2",
            "title": "Protocol Version",
            "type": "string"
          },
          "remaining_step_budget": {
            "minimum": 1,
            "title": "Remaining Step Budget",
            "type": "integer"
          },
          "remaining_tool_budget": {
            "minimum": 0,
            "title": "Remaining Tool Budget",
            "type": "integer"
          },
          "step_ordinal": {
            "minimum": 1,
            "title": "Step Ordinal",
            "type": "integer"
          },
          "trigger": {
            "enum": [
              "initial",
              "tool_results_committed",
              "stop_guard_continue",
              "driver_feedback"
            ],
            "title": "Trigger",
            "type": "string"
          },
          "turn_id": {
            "pattern": "^turn_.+",
            "title": "Turn Id",
            "type": "string"
          },
          "worker_session_id": {
            "pattern": "^worker_.+",
            "title": "Worker Session Id",
            "type": "string"
          }
        },
        "required": [
          "protocol_version",
          "message_type",
          "message_id",
          "worker_session_id",
          "turn_id",
          "context_revision",
          "step_ordinal",
          "trigger",
          "remaining_step_budget",
          "remaining_tool_budget"
        ],
        "title": "WorkerAdvance",
        "type": "object"
      },
      "WorkerBootstrap": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/$defs/WorkerBootstrapContext"
          },
          "context_revision": {
            "minimum": 1,
            "title": "Context Revision",
            "type": "integer"
          },
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "message_type": {
            "const": "worker_bootstrap",
