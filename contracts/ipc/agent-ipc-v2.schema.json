            "type": "string"
          },
          "turn_id": {
            "pattern": "^turn_.+",
            "title": "Turn Id",
            "type": "string"
          },
          "worker_session_id": {
            "pattern": "^worker_.+",
            "title": "Worker Session Id",
            "type": "string"
          }
        },
