            "type": "string"
          },
          "step_ordinal": {
            "minimum": 1,
            "title": "Step Ordinal",
            "type": "integer"
          },
          "text": {
            "default": "",
            "title": "Text",
            "type": "string"
          },
          "tool_calls": {
            "default": [],
            "items": {
              "$ref": "#/$defs/WorkerToolCall"
            },
            "title": "Tool Calls",
            "type": "array"
