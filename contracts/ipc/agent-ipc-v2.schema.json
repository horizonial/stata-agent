        "additionalProperties": false,
        "properties": {
          "context_revision": {
            "minimum": 1,
            "title": "Context Revision",
            "type": "integer"
          },
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "message_type": {
            "const": "worker_shutdown",
            "title": "Message Type",
            "type": "string"
          },
          "protocol_version": {
            "const": "2",
            "title": "Protocol Version",
            "type": "string"
          },
          "turn_id": {
            "pattern": "^turn_.+",
            "title": "Turn Id",
            "type": "string"
          },
          "worker_session_id": {
            "pattern": "^worker_.+",
