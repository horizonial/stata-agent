      "WorkerCompletion": {
        "additionalProperties": false,
        "properties": {
          "disposition": {
            "enum": [
              "succeed",
              "partial",
              "pause",
              "fail"
            ],
            "title": "Disposition",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "disposition",
          "summary"
        ],
        "title": "WorkerCompletion",
        "type": "object"
      },
      "WorkerEvaluation": {
        "additionalProperties": false,
